# Application Environment Variables
VITE_APP_TITLE="Vue 3 Master Template"
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_ENABLE_MOCK_API=false
VITE_APP_ENV="development"

# Default Demo Credentials — must match nuxt-template-v2's seeded in-memory
# users (server/utils/db.ts). There is no "dev" user there; the second seeded
# account is a "manager".
VITE_DEMO_ADMIN_EMAIL="admin@example.com"
VITE_DEMO_ADMIN_PASSWORD="password123"
VITE_DEMO_MANAGER_EMAIL="alex@example.com"
VITE_DEMO_MANAGER_PASSWORD="password123"
VITE_DEMO_USER_EMAIL="user@example.com"
VITE_DEMO_USER_PASSWORD="password123"
